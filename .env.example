# Waypoint Hub settings
# --------------------
# Copy this file to ".env.local" and fill in the values. ".env.local" is never committed to GitHub.
# In Vercel, add the same names under Project → Settings → Environment Variables.

# Supabase (Project Settings → API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts sb_publishable_). Safe to be public: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (starts sb_secret_). KEEP PRIVATE: it bypasses all permissions.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The address the app runs at. http://localhost:3000 on your computer, https://waypointhub.org live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show the "Continue with Google" button once Google sign-in is set up in Supabase (true/false).
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# TEST PROJECT ONLY: lets `npm run seed` add fake data, and shows one-click test logins on the sign-in page.
# Never set these on the live project.
ALLOW_SEED=false
ENABLE_DEV_LOGIN=false

# --- Later phases (leave blank for now) ---
# ShiftCare (Phase 5): Account ID is the username, API key is the password.
SHIFTCARE_ACCOUNT_ID=
SHIFTCARE_API_KEY=
# MessageMedia SMS (Phase 3)
MESSAGEMEDIA_API_KEY=
MESSAGEMEDIA_API_SECRET=
# Google OAuth for Gmail + Calendar (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored OAuth tokens (Phase 3). Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Cloudflare Turnstile spam protection for public forms (Phase 2)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Protects scheduled jobs (any long random string)
CRON_SECRET=
